# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-64-byte-base64-secret

# Optional. Access tokens are short-lived JWTs (default 3600s). Refresh tokens are long-lived,
# rotating, single-use, and stored only as a SHA-256 hash.
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Optional. Database connection; defaults match docker-compose.yml's postgres service.
DATABASE_URL=jdbc:postgresql://localhost:5432/novalearn
DATABASE_USERNAME=novalearn
DATABASE_PASSWORD=novalearn

# Optional. Redis connection for rate limiting; defaults match docker-compose.yml's redis service.
# If Redis is unreachable, rate limiting fails open (allows requests) rather than breaking the API.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional. Requests per minute per client IP allowed on POST /api/v1/auth/**.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Optional. Requests per minute per child allowed on the AI-backed tutor/homework endpoints.
AI_RATE_LIMIT_PER_MINUTE=20

# Optional. Unset or blank -> the AI tutor and homework helper use deterministic offline
# templates (default). Set -> they call the real Anthropic Messages API instead. Never commit
# a real key.
ANTHROPIC_API_KEY=
