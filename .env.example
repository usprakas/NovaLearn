# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-64-byte-base64-secret

# Optional. Access tokens are short-lived JWTs (default 3600s). Refresh tokens are long-lived,
# rotating, single-use, and stored only as a SHA-256 hash.
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Optional. Database connection; defaults match docker-compose.yml's postgres service.
DATABASE_URL=jdbc:postgresql://localhost:5432/novalearn
DATABASE_USERNAME=novalearn
DATABASE_PASSWORD=novalearn

# Optional. Comma-separated browser origins allowed to call this API cross-origin (supports "*"
# wildcards, e.g. "http://localhost:*"). Empty by default, which blocks every cross-origin
# request — a deployment has to opt in explicitly to the origin(s) its own frontend is served from.
ALLOWED_ORIGINS=

# Optional. Which port the API listens on. Most PaaS hosts (e.g. Render) inject this themselves;
# leave unset for local/Docker Compose use, where it defaults to 8080.
PORT=8080

# Optional. Redis connection for rate limiting; defaults match docker-compose.yml's redis service.
# If Redis is unreachable, rate limiting falls back to an in-process counter (exact for a single
# instance) rather than breaking the API or disabling the limits.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional. Requests per minute per client IP allowed on POST /api/v1/auth/**.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Optional. Requests per minute per child allowed on the AI-backed tutor/homework endpoints.
AI_RATE_LIMIT_PER_MINUTE=20

# Optional. Unset or blank -> the AI tutor and homework helper use deterministic offline
# templates (default). Set -> they call the real Anthropic Messages API instead. Never commit
# a real key. Takes precedence over GEMINI_API_KEY if both are set.
ANTHROPIC_API_KEY=

# Optional. Used only if ANTHROPIC_API_KEY above is unset/blank. Free-tier key from
# https://aistudio.google.com/app/apikey. Note: Google's free tier uses submitted content to
# improve their products — reasonable for local testing, not for real children's data in
# production unless that trade-off has been explicitly accepted. Never commit a real key.
GEMINI_API_KEY=
